<%- include('partials/app-start') %>
<section class="page-heading">
  <div><p class="eyebrow">AUDIT TRAIL</p><h1>Word Manipulation History</h1><p class="muted"><%= upload.original_name %> — submitted operations, approvals, and undo events.</p></div>
  <a class="button button-secondary" href="/word-manipulation?source=<%= upload.id %>:0"><i data-lucide="arrow-left"></i> Back to tool</a>
</section>

<section class="panel word-history-panel">
  <div class="panel-heading"><div><h2>Operation history</h2><p>Before-and-after values are saved for every changed cell.</p></div></div>
  <% if (history.length) { %>
    <div class="word-history-list">
      <% history.forEach((item) => { %>
        <details class="word-history-item">
          <summary><span><b><%= item.displayOperation %></b><small>Worksheet <%= item.worksheet_index + 1 %> · By <%= item.username %> · <%= new Date(item.created_at).toLocaleString() %></small></span><span class="word-history-meta"><b><%= Number(item.change_count).toLocaleString() %></b> cells · <span class="word-history-status status-<%= item.status %>"><%= item.status %></span></span></summary>
          <div class="table-wrap"><table><thead><tr><th>Cell</th><th>Original value</th><th>Modified value</th></tr></thead><tbody>
            <% item.cellChanges.forEach((change) => { %><tr><td><%= change.cell_reference %></td><td class="word-value-cell"><%= change.original_value %></td><td class="word-value-cell"><%= change.modified_value %></td></tr><% }) %>
          </tbody></table></div>
          <% if (Number(item.change_count) > item.cellChanges.length) { %><a class="table-link word-history-detail-link" href="/word-manipulation/history/<%= upload.id %>/<%= item.id %>">View all <%= Number(item.change_count).toLocaleString() %> cell changes</a><% } %>
        </details>
      <% }) %>
    </div>
    <% if (canUndo) { %>
      <form action="/word-manipulation/history/<%= upload.id %>/undo" method="post" class="word-undo-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="expectedRevision" value="<%= revision %>">
        <span class="small-note">Undo the most recent applied operation for this workbook.</span>
        <button class="button button-secondary" type="submit"><i data-lucide="undo-2"></i> Undo latest operation</button>
      </form>
    <% } %>
    <% if (pageCount > 1) { %>
      <nav class="pagination" aria-label="Operation history pagination">
        <span>Page <%= page %> of <%= pageCount %> · <%= Number(total).toLocaleString() %> operations</span>
        <div>
          <% if (page > 1) { %><a class="button button-secondary button-small" href="?page=<%= page - 1 %>">Previous</a><% } %>
          <% if (page < pageCount) { %><a class="button button-secondary button-small" href="?page=<%= page + 1 %>">Next</a><% } %>
        </div>
      </nav>
    <% } %>
  <% } else { %>
    <div class="empty-state empty-history"><div class="empty-icon"><i data-lucide="history"></i></div><h3>No manipulation history</h3><p>Confirmed changes will appear here.</p><a class="button button-primary button-small" href="/word-manipulation?source=<%= upload.id %>:0">Open Word Manipulation</a></div>
  <% } %>
</section>
<%- include('partials/app-end') %>
