<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | ClearSheet</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="login-page">
  <main class="help-card">
    <a class="brand" href="/login"><span class="brand-mark">C</span><span>ClearSheet</span></a>
    <div class="help-icon" aria-hidden="true">?</div>
    <p class="eyebrow">ACCOUNT SUPPORT</p>
    <h1>Password help</h1>
    <p class="muted">Password recovery is managed by your workspace administrator. Contact them to reset your account securely.</p>
    <a class="button button-primary button-wide" href="/login">Back to sign in</a>
    <p class="small-note">For local development, an administrator can use <code>npm run user:reset-password</code>.</p>
  </main>
</body>
</html>