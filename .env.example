NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=data_profiling_platform
DB_USER=data_app
DB_PASSWORD=replace-with-the-password-you-set-in-MySQL-Workbench
DB_CONNECTION_LIMIT=10
DB_SSL=false
# For a remote database, set DB_SSL=true. DB_SSL_CA may be a local CA file path
# or the full PEM certificate contents (useful for Vercel environment variables).
# DB_SSL_CA=

SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_NAME=data_profile.sid
UPLOAD_MAX_SIZE_MB=10